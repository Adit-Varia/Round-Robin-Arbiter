module round_robin_arbiter (
    input              clk,
    input              rst,
    input      [3:0]   req,
    output reg [3:0]   grant
);

reg [1:0] pointer;
integer i;
reg found;

always @(posedge clk or posedge rst) begin
    if (rst) begin
        pointer <= 2'd0;
        grant   <= 4'b0000;
    end
    else begin
        grant = 4'b0000;
        found = 1'b0;

        // Search starting from pointer
        for (i = 0; i < 4; i = i + 1) begin
            if (!found && req[(pointer + i) % 4]) begin
                grant[(pointer + i) % 4] = 1'b1;
                pointer <= ((pointer + i + 1) % 4);
                found = 1'b1;
            end
        end
    end
end

endmodule
