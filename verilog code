module arbitrter(
input clk,rst,
input [3:0]req,
output reg [3:0]  grant 
);

reg [1:0]pointer;
integer i;
reg granted;


always@(posedge clk)begin 

if(reset)begin
pointer<=0;
granted=0;
end 

else if(!granted)begin
granted=1'b0;
for(i=0;i<5;i=i+1)begin 
case((pointer+i)%4)
2d'0: if(req[0]) begin grant[0] <= 1; granted=1;  pointer<=2'd1; end 
2d'1: if(req[1]) begin grant[1] <= 1; granted=1;  pointer<=2'd2; end 
2d'2: if(req[2]) begin grant[2] <= 1; granted=1;  pointer<=2'd3; end 
2d'3: if(req[3]) begin grant[3] <= 1; granted=1;  pointer<=2'd0; end 
endcase 
end 
end 
end 
endmodule 
